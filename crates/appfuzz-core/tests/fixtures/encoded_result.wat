(component
(import "test:payload/config" (instance $config (export "key" (func (result string)))))
(core module $memory-module
 (memory (export "memory") 1)
 (func (export "realloc") (param i32 i32 i32 i32) (result i32) (i32.const 4096)))
(core instance $mem (instantiate $memory-module))
(alias core export $mem "memory" (core memory $memory))
(alias core export $mem "realloc" (core func $realloc))
(core func $key (canon lower (func $config "key") (memory $memory) (realloc $realloc)))
(core module $guest
 (import "env" "memory" (memory 1))
 (import "env" "key" (func $key (param i32)))
 (data (i32.const 128) "ok")
 (data (i32.const 256) "0123456789abcdef")
 (func (export "run") (result i32) (local $i i32) (local $n i32) (local $byte i32)
  (call $key (i32.const 1024))
  (local.set $n (i32.load (i32.const 1028)))
  (block $done (loop $next
   (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
   (local.set $byte (i32.load8_u (i32.add (i32.load (i32.const 1024)) (local.get $i))))
   (i32.store8 (i32.add (i32.const 8192) (i32.mul (local.get $i) (i32.const 2)))
    (i32.load8_u (i32.add (i32.const 256) (i32.shr_u (local.get $byte) (i32.const 4)))))
   (i32.store8 (i32.add (i32.const 8193) (i32.mul (local.get $i) (i32.const 2)))
    (i32.load8_u (i32.add (i32.const 256) (i32.and (local.get $byte) (i32.const 15)))))
   (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
  (i32.store (i32.const 0) (i32.const 128))
  (i32.store (i32.const 4) (i32.const 2))
  (i32.store (i32.const 8) (i32.const 8192))
  (i32.store (i32.const 12) (i32.mul (local.get $n) (i32.const 2)))
  (i32.const 0)))
(core instance $guest (instantiate $guest (with "env" (instance (export "memory" (memory $memory)) (export "key" (func $key))))))
(type $out (record (field "body" string) (field "metadata" string)))
(export $public-out "response" (type $out))
(func (export "run") (result $public-out) (canon lift (core func $guest "run") (memory $memory))))
