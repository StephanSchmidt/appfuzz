// A small, generic web-app world for the appfuzz bench. Not tied to any
// platform: a request handler plus a few host interfaces.
package bench:web@0.1.0;

interface types {
    record request {
        method: string,
        path: string,
        query: list<tuple<string, string>>,
        form: list<tuple<string, string>>,
        today: string,
        now: string,
    }
    record response {
        status: u16,
        body: string,
        headers: list<tuple<string, string>>,
    }
}

interface items {
    record item { id: u64, name: string, owner: string, score: u32 }
    all: func() -> list<item>;
    get: func(id: u64) -> result<item, string>;
    for-day: func(date: string) -> list<item>;
    children: func(id: u64) -> list<item>;
}

interface store {
    save: func(key: string, value: string) -> result<u64, string>;
    load: func(key: string) -> option<string>;
}

interface mail {
    send: func(to: string, body: string) -> result<_, string>;
}

// Host functions with text that means something: SQL, paths, URLs, shell
// commands, secrets and personal data. The manifests of the labelled apps
// say so.
interface db {
    query: func(sql: string, args: list<string>) -> result<list<list<string>>, string>;
}

interface files {
    read: func(path: string) -> result<string, string>;
}

interface http {
    fetch: func(url: string, auth: string) -> result<string, string>;
}

interface sys {
    run: func(cmd: string) -> result<string, string>;
}

interface config {
    secret: func(name: string) -> string;
}

interface users {
    record user { id: string, name: string, email: string, bio: string, bio-html: string }
    current: func() -> user;
}

// Records that belong to a user.
interface orders {
    record order { id: u64, owner: string, item: string, total: u32 }
    for-user: func(user-id: string) -> list<order>;
    get: func(id: u64) -> result<order, string>;
}

// Customer records: the whole collection, or a page at a time.
interface customers {
    record customer { id: u64, name: string, balance: s64, notes: string }
    record customer-page { items: list<customer>, next: option<string> }
    all: func() -> list<customer>;
    page: func(offset: u32, limit: u32) -> list<customer>;
    after: func(cursor: option<string>, limit: u32) -> result<customer-page, string>;
}

// Sales deals and booked slots: records that belong to a user.
interface deals {
    record deal { id: u64, owner: string, title: string, amount: u32 }
    all: func() -> list<deal>;
    for-owner: func(owner: string) -> list<deal>;
}

interface slots {
    record slot { id: u64, owner: string, time: string, note: string }
    all: func() -> list<slot>;
}

interface handler {
    use types.{request, response};
    handle: func(req: request) -> response;
}

world app {
    import items;
    import store;
    import mail;
    export handler;
}

// A narrower world for toolchains that import every interface of the world
// they build against (componentize-js, componentize-py).
world items-app {
    import items;
    export handler;
}

// The labelled apps.
world labelled-app {
    import db;
    import files;
    import http;
    import sys;
    import config;
    import users;
    import orders;
    export handler;
}

// The apps that read modeled collections.
world data-app {
    import customers;
    export handler;
}

// The apps whose records belong to users.
world tenant-app {
    import users;
    import deals;
    import slots;
    export handler;
}
