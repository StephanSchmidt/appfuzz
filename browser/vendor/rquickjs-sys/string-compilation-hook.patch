+/* Embedder-owned string compilation observer. It is a context root and
+   is never exposed as a property of a guest-visible JavaScript object. */
+void JS_SetStringCompilationHook(JSContext *ctx, JSValueConst hook)
+{
+    JSValue previous = ctx->string_compilation_hook;
+    ctx->string_compilation_hook = js_dup(hook);
+    JS_FreeValue(ctx, previous);
+}
