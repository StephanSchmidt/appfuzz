# Allowlist: ignore everything, then re-include what is published.
/*
!/.gitignore
!/.github/
!/README.md
!/CHANGELOG.md
!/LICENSE
!/AGENTS.md
!/LABELS.md
!/ENVELOPE.md
!/REFERENCE.md
!/Cargo.toml
!/Cargo.lock
!/Makefile
!/rustfmt.toml
!/clippy.toml
!/deny.toml
!/_typos.toml
!/.gitleaks.toml
!/crates/
!/website/
!/demos/
!/browser/
/browser/js/dist/

/bench/*
!/bench/
!/bench/Cargo.toml
!/bench/Cargo.lock
!/bench/prelude.rs
!/bench/prelude-labelled.rs
!/bench/prelude-data.rs
!/bench/prelude-tenant.rs
!/bench/scripts.rs
!/bench/apps.py
!/bench/demo.sh
!/bench/demo.tape
!/bench/record.sh
!/bench/record-env.sh
!/bench/apps/
!/bench/wit/
!/bench/lang/

# Never, at any depth: build output, dependencies, appfuzz state, binaries.
target/
node_modules/
.zig-cache/
/bench/lang/zig-chatty/gen/
/bench/lang/go-chatty/gen/
/bench/lang/go-chatty/wit/
/bench/lang/cs-chatty/bin/
/bench/lang/cs-chatty/obj/
.appfuzz/
__pycache__/
*.wasm
.env
.env.*
