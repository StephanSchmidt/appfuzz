# Allowlist: ignore everything, then re-include what is published.
/*
!/.gitignore
!/.github/
!/README.md
!/LICENSE
!/AGENTS.md
!/LABELS.md
!/ENVELOPE.md
!/Cargo.toml
!/Cargo.lock
!/crates/
!/website/
!/demos/

/bench/*
!/bench/
!/bench/Cargo.toml
!/bench/Cargo.lock
!/bench/prelude.rs
!/bench/prelude-labelled.rs
!/bench/apps.py
!/bench/apps/
!/bench/wit/
!/bench/lang/

# Never, at any depth: build output, dependencies, appfuzz state, binaries.
target/
node_modules/
.zig-cache/
/bench/lang/zig-chatty/gen/
/bench/lang/go-chatty/gen/
/bench/lang/go-chatty/wit/
.appfuzz/
__pycache__/
*.wasm
.env
.env.*
